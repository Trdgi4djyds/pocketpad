{
  "name": "pocketpad-hub",
  "productName": "PocketPad Hub",
  "version": "1.0.1",
  "description": "PocketPad Hub — transforme votre téléphone en manette PC (USB, Wi-Fi, Internet).",
  "author": "PocketPad",
  "license": "MIT",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "node scripts/selftest.cjs",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "vigemclient": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pocketpad.hub",
    "productName": "PocketPad Hub",
    "copyright": "PocketPad",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "app/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/vigemclient/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PocketPad Hub",
      "artifactName": "PocketPad-Hub-Setup.${ext}",
      "include": "build/installer.nsh",
      "perMachine": true,
      "allowElevation": true
    },
    "portable": {
      "artifactName": "PocketPad-Hub-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "PocketPad-Hub-${version}.${ext}"
    }
  }
}
